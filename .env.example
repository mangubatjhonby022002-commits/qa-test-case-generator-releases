# Get a key at https://aistudio.google.com/apikey
# Every QA user can also enter the key in the app: Settings -> Gemini API key.
# It is then stored encrypted with the Windows key store (per Windows user) and used automatically.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.8-flash
# Lower thinking = faster. Remove this line if your model rejects it.
# GEMINI_THINKING_LEVEL=low   (faster but lower quality - leave off for the best test cases)
# Max length of the AI answer. Raise (e.g. 65536) for very long BRDs if your model allows it.
# GEMINI_MAX_OUTPUT_TOKENS=32768
# How long one AI request may take (milliseconds). Raise it on a slow connection.
# GEMINI_TIMEOUT_MS=600000
# Token for a private releases repository (only needed if the update feed is not public).
# GH_TOKEN=
PORT=3000
# How many BRDs are processed at the same time
CONCURRENCY=3

# Tenant/Admin portal URL used in the Login test case (empty = <TENANT_PORTAL_URL> placeholder)
ADMIN_PORTAL_URL=
# Resident portal URL (empty = <RESIDENT_PORTAL_URL> placeholder)
RESIDENT_PORTAL_URL=

# Add an "Automation Test Scripts" sheet to the workbook (on/off)
AUTOMATION_SHEET=off

# Runs nobody ended are deleted after this many minutes
SESSION_TTL_MINUTES=60

# Screenshots and screen recordings
# Recordings up to this size are sent to the AI as video. Bigger ones (and AVI/MKV/GIF) are turned into frames when ffmpeg is installed.
VIDEO_INLINE_MAX_MB=12
MAX_VIDEO_FRAMES=30
# Largest file you can upload (MB)
MAX_UPLOAD_MB=200
