# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.8-flash
# Lower thinking = faster. Remove this line if your model rejects it.
# GEMINI_THINKING_LEVEL=low   (faster but lower quality - leave off for the best test cases)
# Max length of the AI answer. Raise (e.g. 65536) for very long BRDs if your model allows it.
# GEMINI_MAX_OUTPUT_TOKENS=32768
PORT=3000
# How many BRDs are processed at the same time
CONCURRENCY=3

# Tenant/Admin portal URL used in the Login test case (empty = <TENANT_PORTAL_URL> placeholder)
ADMIN_PORTAL_URL=
# Resident portal URL (empty = <RESIDENT_PORTAL_URL> placeholder)
RESIDENT_PORTAL_URL=

# Add an "Automation Test Scripts" sheet to the workbook (on/off)
AUTOMATION_SHEET=off

# Runs nobody ended are deleted after this many minutes
SESSION_TTL_MINUTES=60
